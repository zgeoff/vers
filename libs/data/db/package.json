{
  "name": "@vers/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test-support": "./src/test-support/index.ts"
  },
  "scripts": {
    "db:codegen": "kysely-codegen --camel-case --out-file src/schema.generated.ts && oxfmt src/schema.generated.ts",
    "db:migrate": "kysely migrate:latest",
    "db:migrate:make": "kysely migrate:make",
    "db:rollback": "kysely migrate:down",
    "db:seed": "kysely seed run",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "kysely": "catalog:",
    "kysely-postgres-js": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-node": "catalog:",
    "@paralleldrive/cuid2": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@zgeoff/bun-test-extended": "catalog:",
    "kysely-codegen": "catalog:",
    "kysely-ctl": "catalog:",
    "pg": "catalog:",
    "tiny-invariant": "catalog:",
    "typescript": "catalog:"
  }
}

{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "ui": "stream",
  "boundaries": {
    "tags": {
      "app": {
        "dependencies": {},
        "dependents": {
          "deny": ["lib", "service"]
        }
      },
      "lib": {
        "dependencies": {
          "deny": ["app", "service"]
        }
      },
      "server-only": {
        "dependents": {
          "allow": ["server-only", "service"]
        }
      },
      "service": {
        "dependencies": {
          "deny": ["app"]
        }
      }
    }
  },
  "tasks": {
    "//#format": {
      "cache": false
    },
    "//#lint": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "codegen", "typegen"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", "build/**", ".react-router/**"]
    },
    "codegen": {
      "dependsOn": ["^codegen"],
      "inputs": ["$TURBO_DEFAULT$", "panda.config.ts"],
      "outputs": ["styled-system/**", "src/styled-system/**", "app/styled-system/**"]
    },
    "typegen": {
      "outputs": ["src/routeTree.gen.ts"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "codegen", "typegen"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["codegen", "typegen"],
      "outputs": []
    },
    // the skill-gate suite runs the hook against the repo's own rules and skills, which sit
    // outside the package, so a change to them must miss the cache
    "@vers/scripts#test": {
      "dependsOn": ["codegen", "typegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.claude/skill-gate.json",
        "$TURBO_ROOT$/.claude/hooks/skill-gate/**",
        "$TURBO_ROOT$/.claude/skills/*/SKILL.md"
      ],
      "outputs": []
    },
    "e2e": {
      // the build dependency keeps the production-artifact webServer from rebuilding: the e2e
      // run serves whatever this task graph just built (or restored from cache)
      "dependsOn": ["@vers/web#build", "@vers/web#codegen", "@vers/web#typegen"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

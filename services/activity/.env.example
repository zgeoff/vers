# base service env every domain service reads; see docs/architecture/platform/deployment.md
NODE_ENV="development"
HOSTNAME="0.0.0.0"
PORT="3006"

# PEM-encoded public key the s2s auth middleware verifies request tokens against
SERVICE_AUTH_PUBLIC_KEY=

# PEM-encoded private key the activity service signs its replay wake-poke tokens with
SERVICE_AUTH_PRIVATE_KEY=

# postgres connection string the activity checkpoint store reads and writes
DATABASE_URL=

# origin of the replay service a committed append pokes to drain claimable verification work
REPLAY_SERVICE_URL="http://localhost:3009"

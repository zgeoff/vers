# base service env every domain service reads; see docs/architecture/platform/deployment.md
NODE_ENV="development"
HOSTNAME="0.0.0.0"
PORT="3006"

# JSON JWKS holding each minting issuer's public key under its kid; the s2s auth middleware only
# verifies a request token against the key registered for its claimed issuer
SERVICE_AUTH_JWKS=

# PEM-encoded private key the activity service signs its replay wake-poke and keys s2s tokens with
SERVICE_AUTH_PRIVATE_KEY=

# postgres connection string the activity checkpoint store reads and writes
DATABASE_URL=

# origin of the keys service a start reads its worldmap scope secret from
KEYS_SERVICE_URL="http://localhost:3008"

# origin of the replay service a committed append pokes to drain claimable verification work
REPLAY_SERVICE_URL="http://localhost:3009"

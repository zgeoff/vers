# base service env every domain service reads; see docs/architecture/deployment.md
NODE_ENV="development"
HOSTNAME="0.0.0.0"
PORT="3008"

# PEM-encoded public key the s2s auth middleware verifies request tokens against
SERVICE_AUTH_PUBLIC_KEY=

# sha256 hex digest of this deploy's baked replay engine bundle
# (scripts/src/deploy/load-engine-hash.ts) — a dispatch call whose simVersion doesn't match this
# value is refused with SIM_VERSION_MISMATCH
SIM_ENGINE_HASH=

# base service env every domain service reads; see docs/architecture/deployment.md
NODE_ENV="development"
HOSTNAME="0.0.0.0"
PORT="3009"

# PEM-encoded public key the s2s auth middleware verifies request tokens against
SERVICE_AUTH_PUBLIC_KEY=

# PEM-encoded private key the replay worker signs its cross-version provider dispatch tokens with
SERVICE_AUTH_PRIVATE_KEY=

# postgres connection string the replay queue, apply, and worker primitives read and write
DATABASE_URL=

# origin of the keys service the mint step dispatches to for a segment's avatar roll key
KEYS_SERVICE_URL="http://localhost:3008"

# sha256 hex digest of this deploy's baked replay engine bundle
# (scripts/src/deploy/load-engine-hash.ts) — a dispatch call whose simVersion doesn't match this
# value is refused with SIM_VERSION_MISMATCH, and a frontier stamped with any other value routes
# through the worker's cross-version dispatch instead of replaying in-process
SIM_ENGINE_HASH=

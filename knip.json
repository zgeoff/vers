{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["infra/sdks/**", "**/augment-bun-test.ts", "**/*.generated.ts", ".claude/**"],
  "ignoreBinaries": ["flyctl", "gh", "ladle", "op", "pulumi", "uv"],
  "rules": {
    "enumMembers": "off"
  },
  "workspaces": {
    ".": {
      "vite": {
        "config": []
      },
      "entry": ["deploy.config.ts"],
      "ignoreDependencies": [
        "@playwright/test",
        "@stylistic/eslint-plugin",
        "@zgeoff/bugsink-mcp",
        "@zgeoff/bun-test-extended",
        "@zgeoff/mcp-remote",
        "@zgeoff/oxlint-config",
        "@zgeoff/umami-mcp",
        "chrome-devtools-mcp"
      ]
    },
    "scripts": {
      "entry": ["src/bin/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@zgeoff/dbhub", "dbhub"]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "src/server.ts",
        "src/start.ts",
        "src/client.tsx",
        "src/start-sentry-react.ts",
        "src/router.tsx",
        "src/mocks/browser.ts",
        "src/lib/scene/types.ts"
      ],
      "ignoreDependencies": ["pino", "pino-pretty"]
    },
    "apps/web-e2e": {
      "entry": ["src/serve-mock-services.ts", "src/serve-resend-stub.ts", "specs/*.spec.ts"]
    },
    "libs/data/db": {
      "entry": ["kysely.config.ts", "migrations/*.ts", "seeds/*.ts"]
    },
    "services/*": {
      "entry": ["src/serve.ts"],
      "ignoreDependencies": ["@orpc/contract"]
    },
    "services/activity": {
      "entry": ["src/serve.ts"]
    },
    "services/email": {
      "entry": ["src/serve.ts", "src/sweep.ts"],
      "ignoreDependencies": ["@orpc/contract"]
    },
    "services/replay": {
      "entry": ["src/serve.ts", "src/serve-provider.ts"]
    },
    "libs/service/service-utils": {
      "ignoreDependencies": ["pino-pretty"]
    },
    "libs/design/design-system": {
      "ignoreDependencies": ["happy-dom"]
    },
    "libs/design/styled-system": {
      "ignoreDependencies": ["react"]
    },
    "libs/game/worldmap-client": {
      "ignoreDependencies": ["happy-dom"]
    },
    "libs/game/idle-client": {
      "ignoreDependencies": ["happy-dom"]
    },
    "libs/game/game-rendering": {
      "ignoreDependencies": ["happy-dom"]
    }
  }
}

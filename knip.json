{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "infra/sdks/**",
    "**/augment-bun-test.ts",
    "**/*.generated.ts",
    ".claude/**",
    ".agents/**"
  ],
  "ignoreBinaries": ["flyctl", "ladle", "op", "pulumi", "uv"],
  "rules": {
    "enumMembers": "off"
  },
  "workspaces": {
    ".": {
      "vite": {
        "config": []
      },
      "entry": ["deploy.config.ts", "rig.config.ts"],
      "ignoreDependencies": [
        "@playwright/test",
        "@zgeoff/agent-hooks",
        "@zgeoff/bugsink-mcp",
        "@zgeoff/bun-test-extended",
        "@zgeoff/diet",
        "@zgeoff/mcp-remote",
        "@zgeoff/rig",
        "@zgeoff/umami-mcp",
        "chrome-devtools-mcp"
      ]
    },
    "scripts": {
      "entry": ["src/bin/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@zgeoff/dbhub", "dbhub"]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "src/server.ts",
        "src/start.ts",
        "src/client.tsx",
        "src/start-sentry-react.ts",
        "src/router.tsx",
        "src/mocks/browser.ts",
        "src/lib/scene/types.ts",
        "src/test-utils/serve-mock-services.ts",
        "src/test-utils/verify/serve-resend-stub.ts",
        "src/test-utils/verify/serve-umami-stub.ts",
        "src/test-utils/write-corpus-artifacts.ts",
        "src/test-utils/verify/verify.ts",
        "src/test-utils/verify/local/run-local-stack.ts",
        "src/test-utils/run-stub-*.ts",
        "e2e/*.test.ts",
        "bench/*.spec.ts"
      ]
    },
    "libs/testing/qa-account": {
      "entry": ["src/bin/*.ts"]
    },
    "libs/testing/service-test-utils": {
      "entry": ["src/bun/fixtures/*.fixture.ts"]
    },
    "libs/testing/load-harness": {
      "entry": ["src/bin/*.ts"]
    },
    "libs/data/db": {
      "entry": ["kysely.config.ts", "migrations/*.ts", "seeds/*.ts"]
    },
    "services/*": {
      "entry": ["src/serve.ts"],
      "ignoreDependencies": ["@orpc/contract"]
    },
    "services/activity": {
      "entry": ["src/serve.ts"]
    },
    "services/email": {
      "entry": ["src/serve.ts", "src/sweep.ts"],
      "ignoreDependencies": ["@orpc/contract"]
    },
    "services/replay": {
      "entry": ["src/serve.ts", "src/serve-provider.ts", "src/drain.ts"]
    },
    "libs/design/design-system": {
      "ignoreDependencies": ["happy-dom"]
    },
    "libs/design/styled-system": {
      "ignoreDependencies": ["react"]
    },
    "libs/game/worldmap-client": {
      "ignoreDependencies": ["happy-dom"]
    },
    "libs/game/idle-client": {
      "ignoreDependencies": ["happy-dom"]
    },
    "libs/game/game-rendering": {
      "ignoreDependencies": ["happy-dom"]
    }
  }
}

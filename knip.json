{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/augment-bun-test.ts",
    "**/*.generated.ts",
    "apps/design-reference/public/**",
    "libs/game/aether-core/generate-graph.ts"
  ],
  "ignoreBinaries": ["ladle", "op", "pulumi"],
  "rules": { "enumMembers": "off" },
  "workspaces": {
    ".": {
      "vite": { "config": [] },
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": [
        "@playwright/test",
        "@stylistic/eslint-plugin",
        "@zgeoff/bun-test-extended",
        "@zgeoff/oxlint-config"
      ]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "src/server.ts",
        "src/client.tsx",
        "src/client-sentry.ts",
        "src/router.tsx",
        "src/mocks/browser.ts",
        "src/lib/scene/types.ts"
      ],
      "ignoreDependencies": ["pino", "pino-pretty"]
    },
    "libs/data/db": {
      "entry": ["kysely.config.ts", "migrations/*.ts", "seeds/*.ts"]
    },
    "services/*": {
      "entry": ["src/serve.ts"],
      "ignoreDependencies": ["@orpc/contract"]
    },
    "libs/service/service-utils": {
      "ignoreDependencies": ["pino-pretty"]
    },
    "libs/design/design-system": {
      "ignoreDependencies": [
        "@fontsource-variable/manrope",
        "@fontsource/chakra-petch",
        "@fontsource/ibm-plex-mono",
        "happy-dom"
      ]
    },
    "libs/design/styled-system": {
      "ignoreDependencies": ["react"]
    },
    "libs/game/aether-client": {
      "ignoreDependencies": ["happy-dom"]
    },
    "libs/core/email": {
      "ignoreDependencies": ["happy-dom"]
    },
    "libs/game/idle-client": {
      "ignoreDependencies": ["happy-dom"]
    },
    "libs/game/game-rendering": {
      "ignoreDependencies": ["happy-dom"]
    }
  }
}

TOKEN product_analytics_read READ

DESCRIPTION >
    Activation funnel: distinct users reaching each stage in order — session started, first
    activity started, first activity completed — inside the requested window.

NODE user_stage_times
SQL >
    %
    SELECT
        user_id,
        minIf(timestamp, event_name = 'session_started') AS first_session,
        minIf(timestamp, event_name = 'activity_started') AS first_activity_started,
        minIf(timestamp, event_name = 'activity_completed') AS first_activity_completed
    FROM product_events
    WHERE timestamp >= {{ DateTime(start_date, '2026-01-01 00:00:00') }}
        AND timestamp < {{ DateTime(end_date, '2100-01-01 00:00:00') }}
    GROUP BY user_id

NODE funnel
SQL >
    SELECT
        countIf(first_session > toDateTime64(0, 3)) AS session_started_users,
        countIf(
            first_session > toDateTime64(0, 3)
            AND first_activity_started >= first_session
        ) AS activity_started_users,
        countIf(
            first_session > toDateTime64(0, 3)
            AND first_activity_started >= first_session
            AND first_activity_completed >= first_activity_started
        ) AS activity_completed_users
    FROM user_stage_times

TYPE ENDPOINT

  "type": "module",
  "scripts": {
    "clean": "./scripts/clean.sh",
    "build": "turbo run build",
    "build:agents": "bash scripts/build-agents-md.sh agents/shared.md agents/project.md AGENTS.md",
    "audit": "bun audit --ignore=GHSA-8988-4f7v-96qf",
    "boundaries": "turbo boundaries",
    "deadcode": "knip",
    "lint": "turbo run codegen typegen && oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:fix": "turbo run codegen typegen && oxlint --type-aware --type-check --report-unused-disable-directives-severity error --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "e2e": "turbo run e2e",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "codegen:styles": "turbo run codegen",
    "codegen:types": "turbo run typegen",
    "deploy": "bun scripts/src/bin/deploy.ts",
    "pg:reset-dev": "bun scripts/src/bin/pg-reset-dev-db.ts",
    "pg:test-container:start": "bun scripts/src/bin/pg-test-container-start.ts",
    "pg:test-container:stop": "bun scripts/src/bin/pg-test-container-stop.ts",
    "ladle:dev": "cd libs/design/design-system && ./node_modules/.bin/ladle dev",
    "stack": "bun scripts/src/bin/stack.ts",
    "---PROJECT-SPECIFIC": "",
    "dev:app-web": "turbo run dev --filter=@vers/web",
    "dev:service-avatar": "bun scripts/src/bin/stack.ts stop service-avatar && dotenvx run -f services/avatar/.env.development -- turbo run dev --filter=@vers/service-avatar",
    "dev:service-session": "bun scripts/src/bin/stack.ts stop service-session && dotenvx run -f services/session/.env.development -- turbo run dev --filter=@vers/service-session",
    "dev:service-user": "bun scripts/src/bin/stack.ts stop service-user && dotenvx run -f services/user/.env.development -- turbo run dev --filter=@vers/service-user",
    "dev:service-verification": "bun scripts/src/bin/stack.ts stop service-verification && dotenvx run -f services/verification/.env.development -- turbo run dev --filter=@vers/service-verification",
    "e2e:app-web": "turbo run e2e --filter=@vers/web-e2e",
    "serve:app-web": "dotenvx run -f apps/web/.env.development.local -- node ./apps/web/server.mjs",
    "---UTILITY": "",
    "prepare": "command -v git > /dev/null 2>&1 && lefthook install --force || true"
  },

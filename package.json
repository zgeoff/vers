{
  "name": "@vers/source",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0",
  "author": "Geoff Whatley <me@geoffwhatley.com> (http://github.com/meatwallace)",
  "workspaces": {
    "packages": [
      "projects/*"
    ],
    "catalog": {
      "@faker-js/faker": "10.5.0",
      "@paralleldrive/cuid2": "2.2.2",
      "@testing-library/jest-dom": "6.6.3",
      "@testing-library/react": "16.2.0",
      "happy-dom": "17.4.3",
      "jose": "6.0.8",
      "postgres": "3.4.5",
      "react": "19.2.7",
      "tiny-invariant": "1.3.3",
      "typescript": "7.0.2",
      "vite": "6.2.2",
      "vitest": "3.0.8",
      "zod": "4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "clean": "./scripts/clean.sh",
    "build": "turbo run build",
    "build:agents": "bash scripts/build-agents-md.sh agents/shared.md agents/project.md AGENTS.md",
    "boundaries": "turbo boundaries",
    "lint": "turbo run codegen typegen && oxlint --type-aware --type-check --report-unused-disable-directives-severity error",
    "lint:fix": "turbo run codegen typegen && oxlint --type-aware --type-check --report-unused-disable-directives-severity error --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "e2e": "turbo run e2e",
    "format": "oxfmt . && format-codemod --quiet .",
    "format:check": "oxfmt --check . && format-codemod --check --quiet .",
    "codegen:styles": "turbo run codegen",
    "codegen:types": "turbo run typegen",
    "pg:reset-dev": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/pg-reset-dev-db.ts",
    "pg:test-container:start": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/pg-test-container-start.ts",
    "pg:test-container:stop": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/pg-test-container-stop.ts",
    "ladle:dev": "cd projects/lib-design-system && ./node_modules/.bin/ladle dev",
    "stack": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/stack-cli.ts",
    "---PROJECT-SPECIFIC": "",
    "dev:app-web": "turbo run dev --filter=@vers/web",
    "dev:service-avatar": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/stack-cli.ts stop service-avatar && dotenvx run -f projects/service-avatar/.env.development -- turbo run dev --filter=@vers/service-avatar",
    "dev:service-session": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/stack-cli.ts stop service-session && dotenvx run -f projects/service-session/.env.development -- turbo run dev --filter=@vers/service-session",
    "dev:service-user": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/stack-cli.ts stop service-user && dotenvx run -f projects/service-user/.env.development -- turbo run dev --filter=@vers/service-user",
    "dev:service-verification": "tsx --tsconfig ./scripts/tsconfig.json ./scripts/stack-cli.ts stop service-verification && dotenvx run -f projects/service-verification/.env.development -- turbo run dev --filter=@vers/service-verification",
    "e2e:app-web": "turbo run e2e --filter=@vers/web-e2e",
    "serve:app-web": "dotenvx run -f projects/app-web/.env.development.local -- node ./projects/app-web/server.mjs",
    "---UTILITY": "",
    "prepare": "lefthook install --force || true"
  },
  "dependencies": {
    "commander": "13.1.0",
    "execa": "9.5.2",
    "ora": "8.2.0",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.0",
    "@dotenvx/dotenvx": "1.38.4",
    "@playwright/test": "1.51.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.3.14",
    "@types/node": "22.13.10",
    "@vitest/coverage-v8": "3.0.8",
    "@zgeoff/bun-test-extended": "0.0.3",
    "@zgeoff/format-codemod": "0.0.5",
    "@zgeoff/oxlint-config": "0.0.3",
    "esbuild": "0.25.1",
    "lefthook": "2.1.9",
    "oxfmt": "0.56.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "postcss": "8.5.3",
    "tslib": "2.8.1",
    "tsx": "4.19.3",
    "turbo": "2.10.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "bun@1.3.10",
  "patchedDependencies": {
    "kysely-codegen@0.20.0": "patches/kysely-codegen@0.20.0.patch"
  }
}

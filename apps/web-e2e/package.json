{
  "name": "@vers/web-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:bench": "playwright test --config playwright.bench.config.ts",
    "e2e:stack": "playwright test --config playwright.stack.config.ts",
    "stack:seed": "bun src/create-stack-seed.ts",
    "test": "bun test --randomize ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:install-browser": "playwright-core install chromium"
  },
  "devDependencies": {
    "@orpc/server": "catalog:",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@vers/contract-activity": "workspace:*",
    "@vers/contract-verification": "workspace:*",
    "@vers/db": "workspace:*",
    "@vers/idle-core": "workspace:*",
    "@vers/mock-services": "workspace:*",
    "@vers/scripts": "workspace:*",
    "@vers/service-auth": "workspace:*",
    "@vers/sim-registry": "workspace:*",
    "@vers/web": "workspace:*",
    "@wringer/browser": "catalog:",
    "@wringer/core": "catalog:",
    "@wringer/db": "catalog:",
    "@wringer/gunshi": "catalog:",
    "@wringer/http": "catalog:",
    "playwright-core": "catalog:",
    "tiny-invariant": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}

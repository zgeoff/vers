  "size-limit": [
    {
      "name": "client entry chunk (measured 163 KB gzipped)",
      "path": "dist/client/assets/index-*.js",
      "gzip": true,
      "limit": "180 KB"
    },
    {
      "name": "idle shared worker (measured 241 KB gzipped)",
      "path": [
        "dist/client/assets/worker-*.js",
        "!dist/client/assets/worker-election-*.js"
      ],
      "gzip": true,
      "limit": "266 KB"
    },
    {
      "name": "idle dedicated worker (measured 243 KB gzipped)",
      "path": "dist/client/assets/worker-election-*.js",
      "gzip": true,
      "limit": "268 KB"
    },
    {
      "name": "all client scripts (measured 1264 KB gzipped)",
      "path": "dist/client/assets/*.js",
      "gzip": true,
      "limit": "1390 KB"
    }
  ],
  "engines": {
    "node": "24.18.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }

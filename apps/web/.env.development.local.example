# 32+ characters — session sealing rejects shorter
SESSION_SECRET=

# any valid Ed25519 key — the mock backend never verifies signatures.
# generate with: openssl genpkey -algorithm ed25519
SERVICE_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEII0t42Zs6tdR0AkoR3hBCw4ACRMg/RPZRdyZ2Pjz+3wc\n-----END PRIVATE KEY-----\n"

# Tinybird Events API origin and append-scoped token — leave unset and product-event delivery is a
# no-op, so local traffic never reaches analytics
# TINYBIRD_URL=
# TINYBIRD_INGEST_TOKEN=

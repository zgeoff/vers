{
  "name": "@vers/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:codegen": "kysely-codegen --camel-case --out-file src/schema.generated.ts && oxfmt src/schema.generated.ts",
    "db:migrate": "kysely migrate:latest",
    "db:migrate:make": "kysely migrate:make",
    "db:rollback": "kysely migrate:down",
    "db:seed": "kysely seed run",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "kysely": "0.29.2",
    "kysely-postgres-js": "3.0.0",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "catalog:",
    "@testcontainers/postgresql": "10.18.0",
    "@types/bun": "1.3.14",
    "@types/node": "22.13.10",
    "@zgeoff/bun-test-extended": "0.0.3",
    "kysely-codegen": "0.20.0",
    "kysely-ctl": "0.21.0",
    "pg": "8.22.0",
    "typescript": "catalog:"
  }
}

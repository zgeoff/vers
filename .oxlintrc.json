{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y"],
  "jsPlugins": [
    "./scripts/src/lint/plugin.js",
    "@zgeoff/oxlint-config/plugin",
    "@stylistic/eslint-plugin"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.0.0"
    }
  },
  "rules": {
    // `executeQuery` implements Kysely's database connection, which calls it
    // by that name
    "zgeoff/function-verb": ["error", { "exemptNames": ["deleteCookie", "executeQuery"] }],

    // the shared config's version minus ignorePattern — baseline(#236)
    // disable directives sit on their own line above the flagged site, and
    // demanding a blank line above them separates them from it
    "@stylistic/lines-around-comment": [
      "error",
      {
        "beforeLineComment": true,
        "beforeBlockComment": true,
        "allowBlockStart": true,
        "allowObjectStart": true,
        "allowArrayStart": true,
        "allowClassStart": true,
        "allowEnumStart": true,
        "allowInterfaceStart": true,
        "allowModuleStart": true,
        "allowTypeStart": true,
        "ignorePattern": "oxlint-disable"
      }
    ],

    // matches the array-type option the former eslint config carried —
    // existing code already writes `Array<T>` throughout
    "typescript/array-type": ["error", { "default": "generic" }],

    // beyond the shared config's rest-sibling allowance, a leading underscore
    // marks a deliberately unused binding (interface-mandated parameters,
    // placeholder args)
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "ignoreRestSiblings": true, "varsIgnorePattern": "^_" }
    ],

    "unicorn/numeric-separators-style": ["error", { "hexadecimal": { "minimumDigits": 10 } }],

    // preload-style modules (matcher registration, stylesheets) are
    // side-effect imports by design
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "@zgeoff/bun-test-extended",
          "@vers/utils/disable-zod-jit",
          "fake-indexeddb/auto",
          "**/augment-bun-test.ts",
          "./disable-zod-jit",
          "**/*.css"
        ]
      }
    ],

    // these type-aware rules need real type info (oxlint + tsgolint via
    // `--type-aware --type-check`) -- the non-type-aware engine skips them
    // silently. All of them are on. The pre-existing backlog (#236) is
    // baselined inline at each violation site with an
    // `oxlint-disable-next-line <rule> -- baseline(#236)` comment rather than
    // left off in config. The ratchet is
    // `--report-unused-disable-directives-severity error`: fixing a baselined
    // site makes its directive stale and lint fails until the comment is
    // deleted, so debt only shrinks from here. New and refactored code is
    // fully enforced from day one.
    "typescript/consistent-return": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-regexp-exec": "error",
    "typescript/require-await": "error",
    "typescript/return-await": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/strict-void-return": "error",
    "typescript/unbound-method": "error",

    // vers-specific: rules oxlint's error-everywhere categories turn on that
    // the former eslint config (built from targeted `recommended` presets,
    // not blanket categories) never enabled, and that fight real patterns in
    // this codebase rather than catch bugs
    //
    // React 19's automatic JSX runtime doesn't require React in scope
    "react/react-in-jsx-scope": "off",
    // style/vendor modules are imported wholesale on purpose
    // (vanilla-extract `*.styles` modules, `jest-extended` matchers)
    "import/no-namespace": "off",
    // leading underscores mark closure-private state in factory functions
    // (`create-simulation.ts`'s `_rng`, `_avatar`, ...) — not accidental
    // globals
    "no-underscore-dangle": "off",
    // whole-prop forwarding (`<svg {...props} className={props.className}>`)
    // is the idiomatic pattern here, more so with `no-destructured-params`
    // in force
    "react/jsx-props-no-spreading": "off",
    // low-level worker/message-port wrapping needs a bare `new Promise`
    // executor with an early-return
    "no-promise-executor-return": "off",
    // false-positives on fluent builder call chains (oRPC's
    // `os.getThing.handler(...)`)
    "new-cap": "off",
    // deeply nested JSX is normal for form/layout composition
    "react/jsx-max-depth": "off",
    // TODO/FIXME comments are tracked deliberately, not banned
    "no-warning-comments": "off",
    // every postMessage in this repo is MessagePort/SharedWorker, where the
    // second parameter is a transfer list — the rule targets
    // window.postMessage and its suggested targetOrigin argument doesn't
    // typecheck here
    "unicorn/require-post-message-target-origin": "off"
  },
  "overrides": [
    {
      // the trace storage constructs AsyncLocalStorage lazily through a
      // namespace import, so browser bundles reaching it through the orpc
      // barrel never touch node:async_hooks at module evaluation; a named
      // import moves that access back to module scope under bundlers that
      // stub the builtin, silently reintroducing the browser throw
      "files": ["**/libs/service/service-utils/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "importNames": ["AsyncLocalStorage"],
                "message": "Import the node:async_hooks namespace (import * as asyncHooks) and construct lazily inside a function — a named import evaluates the browser stub at module scope.",
                "name": "node:async_hooks"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      // ergonomics for every co-located suite, whichever runner it targets: one
      // suite per module with inline test data means file length scales with
      // coverage, not complexity, and non-null assertions on known-shaped
      // fixtures are fine
      "rules": {
        // the shared config exempts only `*.test.ts` from max-lines
        "max-lines": "off",
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      // ambient declaration files exist to augment or side-effect-import
      // third-party module types (`declare module 'hono' { ... }`) — the
      // bare import is how TypeScript merges the augmentation
      "files": ["**/*.d.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      // oxfmt pins comments in JSX attribute lists to the line above and
      // strips any blank line the rule would demand — the formatter owns
      // comment placement in JSX
      "files": ["**/*.tsx"],
      "rules": {
        "@stylistic/lines-around-comment": "off"
      }
    },
    {
      // playwright resolves fixtures by statically parsing the destructure
      // pattern in a test callback's first parameter — a plain parameter
      // fails at collection, so the framework convention wins here
      "files": [
        "**/apps/web-e2e/src/**",
        "**/apps/web-e2e/specs/**",
        "**/apps/web-e2e/benchmarks/**"
      ],
      "rules": {
        "zgeoff/no-destructured-params": "off"
      }
    },
    {
      // react-router's loader/action contract is to throw Response (directly,
      // or via its `redirect()` helper) for redirects and error pages — not an
      // Error instance. all 9 violations `lint:type-aware` found here are that
      // idiom, not a bug
      "files": [
        "**/apps/web/src/routes/**/*.ts",
        "**/apps/web/src/routes/**/*.tsx",
        "**/apps/web/src/lib/activity/**/*.ts",
        "**/apps/web/src/lib/auth/**/*.ts",
        "**/apps/web/src/lib/avatar/**/*.ts",
        "**/apps/web/src/lib/avatar/**/*.tsx"
      ],
      "rules": {
        "typescript/only-throw-error": "off"
      }
    },
    {
      // react-three-fiber props aren't DOM attributes — same ignore list the
      // eslint config carried for the r3f renderer
      "files": ["**/libs/game/worldmap-client/**/*.ts", "**/libs/game/worldmap-client/**/*.tsx"],
      "rules": {
        "react/no-unknown-property": [
          "error",
          {
            "ignore": [
              "args",
              "attach",
              "position",
              "rotation",
              "scale",
              "intensity",
              "geometry",
              "material",
              "far",
              "near",
              "aspect",
              "fov",
              "onUpdate",
              "userData"
            ]
          }
        ]
      }
    },
    {
      // the numeric rule polices only the deterministic simulation core, whose arithmetic must
      // replay to byte-identical results across engine builds
      // (docs/architecture/game/game-simulation.md#the-deterministic-core)
      "files": [
        "**/libs/game/idle-core/src/**",
        "**/libs/game/game-utils/src/**",
        "**/libs/game/item-gen/src/**"
      ],
      "rules": {
        "vers/no-unportable-math": "error"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.nx/**",
    ".worktrees/**",
    ".claude/**",
    "**/*.json",
    "**/*timestamp*.mjs",
    "**/mockServiceWorker.js",
    "**/.react-router/**",
    "**/infra/sdks/**",
    "**/apps/web/src/styled-system/**",
    "**/libs/design/design-system/src/styled-system/**",
    "**/libs/design/styled-system/styled-system/**",
    "**/.ladle/**",
    // kysely-codegen output: generated, so lint has nothing to teach it
    "**/schema.generated.ts"
  ]
}

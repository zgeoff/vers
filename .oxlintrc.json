{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@zgeoff/oxlint-config/oxlintrc.json"],
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react", "jsx-a11y"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "settings": {
    "react": {
      "version": "19.0.0"
    }
  },
  "rules": {
    // `up`/`down` and `seed` are Kysely-mandated migration and seed-file
    // exports; the oRPC handler exemptions mirror their contract procedure
    // names (the contract key is the public API vocabulary) and would
    // misname the public API if renamed
    "zgeoff/function-verb": [
      "error",
      {
        "verbs": [
          "advance",
          "broadcast",
          "compare",
          "dispose",
          "flush",
          "fold",
          "mint",
          "park",
          "record",
          "redirect",
          "refresh",
          "reject",
          "report",
          "restart",
          "roll",
          "schedule",
          "select",
          "serve",
          "submit",
          "sweep",
          "upgrade"
        ],
        "exemptNames": [
          "up",
          "down",
          "seed",
          "changePassword",
          "consumePendingTransaction",
          "consumeTransactionToken",
          "replaySegment",
          "resumeActivity",
          "trackActivityProgress",
          "wake",
          // LRUMap extends the built-in Map and must keep its exact method
          // names to remain a drop-in Map subclass
          "clear",
          "delete"
        ]
      }
    ],

    // the shared config's version minus ignorePattern — baseline(#236)
    // disable directives sit on their own line above the flagged site, and
    // demanding a blank line above them separates them from it
    "@stylistic/lines-around-comment": [
      "error",
      {
        "beforeLineComment": true,
        "beforeBlockComment": true,
        "allowBlockStart": true,
        "allowObjectStart": true,
        "allowArrayStart": true,
        "allowClassStart": true,
        "allowEnumStart": true,
        "allowInterfaceStart": true,
        "allowModuleStart": true,
        "allowTypeStart": true,
        "ignorePattern": "oxlint-disable"
      }
    ],

    // matches the array-type option the former eslint config carried —
    // existing code already writes `Array<T>` throughout
    "typescript/array-type": ["error", { "default": "generic" }],

    // beyond the shared config's rest-sibling allowance, a leading underscore
    // marks a deliberately unused binding (interface-mandated parameters,
    // placeholder args)
    "no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "ignoreRestSiblings": true, "varsIgnorePattern": "^_" }
    ],

    "unicorn/numeric-separators-style": ["error", { "hexadecimal": { "minimumDigits": 10 } }],

    // preload-style modules (matcher registration, stylesheets) are
    // side-effect imports by design
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "@zgeoff/bun-test-extended",
          "fake-indexeddb/auto",
          "**/augment-bun-test.ts",
          "**/*.css"
        ]
      }
    ],

    // these type-aware rules need real type info (oxlint + tsgolint via
    // `--type-aware --type-check`) -- the non-type-aware engine skips them
    // silently. All of them are on. The pre-existing backlog (#236) is
    // baselined inline at each violation site with an
    // `oxlint-disable-next-line <rule> -- baseline(#236)` comment rather than
    // left off in config. The ratchet is
    // `--report-unused-disable-directives-severity error`: fixing a baselined
    // site makes its directive stale and lint fails until the comment is
    // deleted, so debt only shrinks from here. New and refactored code is
    // fully enforced from day one.
    "typescript/consistent-return": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/prefer-nullish-coalescing": "error",
    // `lib-idle-core`/`lib-worldmap-core` tick/lifecycle handlers mutate their
    // entity parameter in place by design -- those sites carry a real reason
    // instead of a baseline marker (see the sim-core exception noted where
    // they occur).
    //
    // `allow` exempts framework/library handles per-arg: readonly is
    // semantically wrong for a live mutable handle (a db client, an HTTP app,
    // a test container), so only params whose *type* matches are exempted --
    // a data param on the same function is still checked. New code marks its
    // own data/config/props types `readonly` rather than suppressing; this
    // list is for the handles it can't (#265).
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "allow": [
          { "from": "package", "name": "Kysely", "package": "kysely" },
          // a live three.js GPU texture handle: upload state and dispose lifecycle, no readonly
          // form
          { "from": "package", "name": "DataTexture", "package": "three" },
          // a live three.js geometry handle: attribute buffers rewritten in place, no readonly
          // form
          { "from": "package", "name": "BufferGeometry", "package": "three" },
          // a live three.js WebGPU node-material handle: shader graph and GPU pipeline state, no
          // readonly form
          { "from": "package", "name": "MeshBasicNodeMaterial", "package": "three" },
          // a live three.js renderer handle: GPU backend and canvas state, no readonly form
          { "from": "package", "name": "WebGPURenderer", "package": "three" },
          // a query-log event: its `query` field is Kysely's internal operation-node AST, built
          // and read by Kysely itself with no readonly form
          { "from": "package", "name": "LogEvent", "package": "kysely" },
          // a live playwright page handle: driver connection and event state, no readonly form
          { "from": "package", "name": "Page", "package": "playwright-core" },
          // a live kysely transaction handle: same mutable connection state as Kysely above
          { "from": "package", "name": "Transaction", "package": "kysely" },
          // a driver's connection-pool handle: structurally a set of method signatures, same as
          // KyselyTransactionLike below
          { "from": "package", "name": "Driver", "package": "kysely" },
          // a live kysely-postgres-js dialect handle: wraps a postgres.js Sql client, no readonly
          // form
          { "from": "package", "name": "PostgresJSDialect", "package": "kysely-postgres-js" },
          // a live pg-boss client handle: connection pool and event emitter state, no readonly form
          { "from": "package", "name": "PgBoss", "package": "pg-boss" },
          // structurally a single method signature, which the rule's default settings treat as
          // mutable (typescript-eslint#8013), same as ReadonlySet below
          { "from": "package", "name": "KyselyTransactionLike", "package": "pg-boss" },
          { "from": "package", "name": "Logger", "package": "pino" },
          // a pino write sink: its single `write` method is behaviour, not data; no readonly form
          { "from": "package", "name": "DestinationStream", "package": "pino" },
          // the router instance: a live handle carrying match/history/cache state it mutates
          // internally on every navigation, so it has no useful readonly form
          { "from": "package", "name": "AnyRouter", "package": "@tanstack/router-core" },
          // the router hands the boundary a live error/reset pair; its `info` member is a
          // mutable React structure with no readonly form
          { "from": "package", "name": "ErrorComponentProps", "package": "@tanstack/router-core" },
          {
            "from": "package",
            "name": "StartedPostgreSqlContainer",
            "package": "@testcontainers/postgresql"
          },
          // a live postgres.js client handle: connection pool state, no readonly form
          { "from": "package", "name": "Sql", "package": "postgres" },
          {
            "from": "package",
            "name": ["AnyContractRouter", "AnyContractProcedure"],
            "package": "@orpc/contract"
          },
          {
            "from": "package",
            "name": ["RPCHandler", "FetchHandler"],
            "package": "@orpc/server"
          },
          // a structural MessagePort union: no readonly form, the same DOM callback shape as
          // MessagePort/EventListenerOrEventListenerObject below
          { "from": "package", "name": "SupportedMessagePort", "package": "@orpc/client" },
          // an Error subclass: the same mutable message/stack state as lib Error below
          { "from": "package", "name": "ORPCError", "package": "@orpc/client" },
          { "from": "package", "name": "SetupServer", "package": "msw" },
          // a response resolver's request context: wraps the live fetch Request; no readonly form
          { "from": "package", "name": "ResponseResolverInfo", "package": "msw" },
          { "from": "package", "name": "Collection", "package": "@msw/data" },
          // a live actor handle: subscription and mailbox state xstate mutates internally, no
          // readonly form
          { "from": "package", "name": "ActorRef", "package": "xstate" },
          // an actor clock handle: its setTimeout/clearTimeout methods are behaviour, not data
          { "from": "package", "name": "Clock", "package": "xstate" },
          {
            "from": "package",
            "name": ["CryptoKey", "Request", "Response", "AbortSignal"],
            "package": "@types/node"
          },
          {
            "from": "lib",
            "name": [
              "Request",
              "Response",
              "Date",
              "Error",
              "Headers",
              "FormData",
              "HTMLFormElement",
              "Event",
              "MessageEvent",
              "MessagePort",
              "EventListenerOrEventListenerObject",
              "SharedWorker",
              "Uint8Array",
              "URL",
              "KeyboardEvent",
              "MouseEvent",
              // a live cancellation handle: addEventListener/aborted state, no readonly form
              "AbortSignal",
              // the mutable handle behind AbortSignal above: its whole purpose is the `abort()`
              // call, so it has no readonly form either
              "AbortController",
              // genuinely immutable, but its members are method signatures, which the
              // rule's default settings treat as mutable (typescript-eslint#8013)
              "ReadonlySet",
              "ReadonlyMap"
            ]
          },
          // zustand's own generic callback type; it has no readonly form
          { "from": "package", "name": "StateCreator", "package": "zustand" },
          { "from": "package", "name": "ReactNode", "package": "react" },
          { "from": "package", "name": "SyntheticEvent", "package": "react" },
          { "from": "package", "name": "ElementType", "package": "react" },
          { "from": "package", "name": "ChangeEvent", "package": "react" },
          // a ref's entire purpose is its mutable `.current` slot, so it has
          // no useful readonly form
          { "from": "package", "name": "RefObject", "package": "react" },
          {
            "from": "package",
            "name": ["SVGProps", "InputHTMLAttributes", "LabelHTMLAttributes", "HTMLAttributes"],
            "package": "react"
          },
          { "from": "package", "name": "ZodError", "package": "zod" },
          // a schema's validation/refinement methods, no readonly form
          { "from": "package", "name": "ZodType", "package": "zod" },
          { "from": "package", "name": "JWTPayload", "package": "jose" },
          { "from": "package", "name": "SubmissionResult", "package": "@conform-to/dom" },
          { "from": "package", "name": "Context", "package": "hono" },
          { "from": "package", "name": "PostgresError", "package": "postgres" },
          // stateful factory-return handle: getInt/getSeries/generateNewSeed
          // close over a mutable seed, so there is no readonly form to consume
          { "from": "file", "name": "RNG", "path": "../game-utils/src/types.ts" },
          // three.js scene-graph handles: mutated in place every frame
          // (position/rotation writes, matrix updates) by design, so no
          // readonly form of them is useful to a caller
          {
            "from": "package",
            "name": ["Object3D", "Mesh", "PerspectiveCamera", "OrthographicCamera"],
            "package": "three"
          },
          // r3f pointer event: intersects a live DOM PointerEvent, which has
          // no readonly form
          { "from": "package", "name": "ThreeEvent", "package": "@react-three/fiber" },
          // idle-core's live domain objects are mutable handles: entities and
          // the simulation own internal state that tick/lifecycle code drives
          // through mutation methods (receiveDamage, setState, scheduleEvent),
          // and the *Data seeds are mutated in place during setup -- none has a
          // readonly form a caller can consume, so they are exempted by type
          {
            "from": "file",
            "name": [
              "ActivityInput",
              "ActivitySnapshot",
              "WorldMapEncounterActivityInput",
              "Activity"
            ],
            "path": "../idle-core/src/types/activity.ts"
          },
          // from-file paths resolve against the consuming package's directory, so
          // consumers outside libs/game/ need their own entry per depth
          {
            "from": "file",
            "name": [
              "ActivityInput",
              "ActivitySnapshot",
              "WorldMapEncounterActivityInput",
              "Activity"
            ],
            "path": "../../libs/game/idle-core/src/types/activity.ts"
          },
          {
            "from": "file",
            "name": ["AvatarData", "EnemyData", "Avatar", "Enemy", "Wave"],
            "path": "../idle-core/src/types/entities.ts"
          },
          {
            "from": "file",
            "name": ["AvatarData", "EnemyData", "Avatar", "Enemy", "Wave"],
            "path": "../../libs/game/idle-core/src/types/entities.ts"
          },
          {
            "from": "file",
            "name": ["Simulation", "SimulationContext", "SimulationDriver"],
            "path": "../idle-core/src/types/simulation.ts"
          },
          {
            "from": "file",
            "name": ["Simulation", "SimulationContext", "SimulationDriver"],
            "path": "../../libs/game/idle-core/src/types/simulation.ts"
          },
          {
            "from": "file",
            "name": ["ActivityExecutor", "CombatExecutor"],
            "path": "../idle-core/src/types/combat.ts"
          },
          {
            "from": "file",
            "name": ["Behaviour", "AvatarBehaviour", "EnemyBehaviour"],
            "path": "../idle-core/src/types/behaviour.ts"
          }
        ]
      }
    ],
    "typescript/prefer-regexp-exec": "error",
    "typescript/require-await": "error",
    "typescript/return-await": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/strict-void-return": "error",
    "typescript/unbound-method": "error",

    // vers-specific: rules oxlint's error-everywhere categories turn on that
    // the former eslint config (built from targeted `recommended` presets,
    // not blanket categories) never enabled, and that fight real patterns in
    // this codebase rather than catch bugs
    //
    // React 19's automatic JSX runtime doesn't require React in scope
    "react/react-in-jsx-scope": "off",
    // style/vendor modules are imported wholesale on purpose
    // (vanilla-extract `*.styles` modules, `jest-extended` matchers)
    "import/no-namespace": "off",
    // leading underscores mark closure-private state in factory functions
    // (`create-simulation.ts`'s `_rng`, `_avatar`, ...) — not accidental
    // globals
    "no-underscore-dangle": "off",
    // whole-prop forwarding (`<svg {...props} className={props.className}>`)
    // is the idiomatic pattern here, more so with `no-destructured-params`
    // in force
    "react/jsx-props-no-spreading": "off",
    // forcing the `/u` flag on every regex (including simple literals in
    // assertions and matchers) is broader than this repo wants
    "require-unicode-regexp": "off",
    // arbitrary size/complexity caps this repo has never enforced —
    // simulation and rendering code legitimately runs long
    "max-statements": "off",
    "max-lines-per-function": "off",
    "max-lines": "off",
    "max-params": "off",
    "import/max-dependencies": "off",
    // inline comments and `continue` are normal control flow here, not
    // smells
    "no-inline-comments": "off",
    "no-continue": "off",
    "init-declarations": "off",
    // sequential awaits inside a loop are intentional in conformance-test
    // iteration and simulation stepping
    "no-await-in-loop": "off",
    // low-level worker/message-port wrapping needs a bare `new Promise`
    // executor with an early-return
    "no-promise-executor-return": "off",
    "promise/avoid-new": "off",
    // false-positives on fluent builder call chains (oRPC's
    // `os.getThing.handler(...)`)
    "new-cap": "off",
    // deeply nested JSX is normal for form/layout composition
    "react/jsx-max-depth": "off",
    // TODO/FIXME comments are tracked deliberately, not banned
    "no-warning-comments": "off",
    // every postMessage in this repo is MessagePort/SharedWorker, where the
    // second parameter is a transfer list — the rule targets
    // window.postMessage and its suggested targetOrigin argument doesn't
    // typecheck here
    "unicorn/require-post-message-target-origin": "off"
  },
  "overrides": [
    {
      // the trace storage constructs AsyncLocalStorage lazily through a
      // namespace import, so browser bundles reaching it through the orpc
      // barrel never touch node:async_hooks at module evaluation; a named
      // import moves that access back to module scope under bundlers that
      // stub the builtin, silently reintroducing the browser throw
      "files": ["**/libs/service/service-utils/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "importNames": ["AsyncLocalStorage"],
                "message": "Import the node:async_hooks namespace (import * as asyncHooks) and construct lazily inside a function — a named import evaluates the browser stub at module scope.",
                "name": "node:async_hooks"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/schema.generated.ts"],
      // kysely-codegen column overrides emit inline `import()` type annotations; the file is
      // generated, so the style rule has nothing to teach it
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      // ergonomics for every co-located suite, whichever runner it targets: one
      // suite per module with inline test data means file length scales with
      // coverage, not complexity, and non-null assertions on known-shaped
      // fixtures are fine
      "rules": {
        "max-lines": "off",
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      // ambient declaration files exist to augment or side-effect-import
      // third-party module types (`declare module 'hono' { ... }`) — the
      // bare import is how TypeScript merges the augmentation
      "files": ["**/*.d.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      // oxfmt pins comments in JSX attribute lists to the line above and
      // strips any blank line the rule would demand — the formatter owns
      // comment placement in JSX
      "files": ["**/*.tsx"],
      "rules": {
        "@stylistic/lines-around-comment": "off"
      }
    },
    {
      // playwright resolves fixtures by statically parsing the destructure
      // pattern in a test callback's first parameter — a plain parameter
      // fails at collection, so the framework convention wins here
      "files": [
        "**/apps/web-e2e/src/**",
        "**/apps/web-e2e/specs/**",
        "**/apps/web-e2e/benchmarks/**"
      ],
      "rules": {
        "zgeoff/no-destructured-params": "off"
      }
    },
    {
      // react-router's loader/action contract is to throw Response (directly,
      // or via its `redirect()` helper) for redirects and error pages — not an
      // Error instance. all 9 violations `lint:type-aware` found here are that
      // idiom, not a bug
      "files": [
        "**/apps/web/src/routes/**/*.ts",
        "**/apps/web/src/routes/**/*.tsx",
        "**/apps/web/src/lib/activity/**/*.ts",
        "**/apps/web/src/lib/auth/**/*.ts",
        "**/apps/web/src/lib/avatar/**/*.ts",
        "**/apps/web/src/lib/avatar/**/*.tsx"
      ],
      "rules": {
        "typescript/only-throw-error": "off"
      }
    },
    {
      // react-three-fiber props aren't DOM attributes — same ignore list the
      // eslint config carried for the r3f renderer
      "files": ["**/libs/game/worldmap-client/**/*.ts", "**/libs/game/worldmap-client/**/*.tsx"],
      "rules": {
        "react/no-unknown-property": [
          "error",
          {
            "ignore": [
              "args",
              "attach",
              "position",
              "rotation",
              "scale",
              "intensity",
              "geometry",
              "material",
              "far",
              "near",
              "aspect",
              "fov",
              "onUpdate",
              "userData"
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.nx/**",
    ".worktrees/**",
    ".claude/**",
    "**/*.json",
    "**/*timestamp*.mjs",
    "**/mockServiceWorker.js",
    "**/.react-router/**",
    "**/infra/sdks/**",
    "**/apps/web/src/styled-system/**",
    "**/libs/design/design-system/src/styled-system/**",
    "**/libs/design/styled-system/styled-system/**",
    "**/.ladle/**"
  ]
}

{
  "mcpServers": {
    "axiom": {
      "type": "http",
      "url": "https://mcp.axiom.co/mcp"
    },
    "neon": {
      "type": "http",
      "url": "https://mcp.neon.tech/mcp?readonly=true"
    },
    "bugsink": {
      "command": "sh",
      "args": [
        "-c",
        "BUGSINK_TOKEN=\"$(op read 'op://vers/bugsink/mcp-token')\" exec ./node_modules/.bin/bugsink-mcp"
      ],
      "env": {
        "BUGSINK_URL": "https://vers-bugsink.fly.dev"
      }
    },
    "postgres": {
      "command": "bun",
      "args": ["scripts/src/bin/pg-mcp-launch.ts"]
    },
    "chrome-devtools": {
      "command": "sh",
      "args": [
        "-c",
        "exec ./node_modules/.bin/chrome-devtools-mcp --browser-url \"http://$(ip route show default | awk '{print $3; exit}'):9223\""
      ]
    },
    "tinybird": {
      "command": "sh",
      "args": [
        "-c",
        "exec ./node_modules/.bin/mcp-remote \"https://mcp.tinybird.co?token=$(op read 'op://vers/tinybird/read-token')&host=https://api.us-east.tinybird.co\""
      ]
    },
    "umami": {
      "command": "sh",
      "args": [
        "-c",
        "UMAMI_USERNAME=\"$(op read 'op://vers/umami/username')\" UMAMI_PASSWORD=\"$(op read 'op://vers/umami/password')\" exec ./node_modules/.bin/umami-mcp"
      ],
      "env": {
        "UMAMI_API_BASE": "https://vers-umami.fly.dev/api"
      }
    },
    "serena": {
      "type": "http",
      "url": "http://127.0.0.1:9121/mcp"
    }
  }
}
